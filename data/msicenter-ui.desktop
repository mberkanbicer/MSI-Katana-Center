[Desktop Entry]
Type=Application
Name=MSI Katana Center
GenericName=MSI laptop hardware management
Comment=Status and gated hardware controls for MSI laptops
Exec=msicenter-ui
Icon=msicenter-ui
Terminal=false
Categories=Utility;Settings;System;
Keywords=MSI;laptop;fan;RGB;battery;hardware;
StartupNotify=false
Actions=CoolerBoostOn;CoolerBoostOff;RgbOff;

[Desktop Action CoolerBoostOn]
Name=Cooler Boost on
Exec=msicenter cooler-boost on

[Desktop Action CoolerBoostOff]
Name=Cooler Boost off
Exec=msicenter cooler-boost off

[Desktop Action RgbOff]
Name=Keyboard RGB off
Exec=msicenter rgb-color f 000000
